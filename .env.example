# === API Keys (REQUIRED) ===
# Get Sarvam API key from: https://console.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Get Groq API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

